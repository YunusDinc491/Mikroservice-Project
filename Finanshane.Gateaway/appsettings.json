{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/Auth/{**catch-all}"
        }
      },
      "portfolio-route": {
        "ClusterId": "portfolio-cluster",
        "Match": {
          "Path": "/api/Portfolio/{**catch-all}"
        }
      },
      "marketdata-route": {
        "ClusterId": "marketdata-cluster",
        "Match": {
          "Path": "/api/MarketData/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-destination": {
            "Address": "https://localhost:7023/"
          }
        }
      },
      "portfolio-cluster": {
        "Destinations": {
          "portfolio-destination": {
            "Address": "https://localhost:7016/"
          }
        }
      },
      "marketdata-cluster": {
        "Destinations": {
          "marketdata-destination": {
            "Address": "https://localhost:7281/"
          }
        }
      }
    }
  }
}